<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 8.18 — replaces `@android:style/Theme.DeviceDefault.NoActionBar` with
  a thin wrapper that sets `android:windowBackground` to the Linear dark canvas
  color (`#010102`, matching `LinearColors.Canvas` in Theme.kt) so the launch
  splash stops flashing white before Compose has a chance to render.

  We inherit from the platform NoActionBar theme to keep the rest of the
  window-decor behaviour identical (status bar, navigation bar, transitions).
  When Compose resumes layout, it paints over this background with the real
  `TemuBelajarTheme` so there's no visible "splash" surface — just a single
  dark flash instead of a single white flash. No theme overhaul required.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Linear canvas color used both for the splash windowBackground
         below and (potentially) for future splash-screenAPI resources.
         Keep this value in sync with `LinearColors.Canvas` in
         `composeApp/src/commonMain/.../core/ui/Theme.kt`. -->
    <color name="tb_canvas">#010102</color>

    <style name="Theme.TemuBelajar" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tb_canvas</item>
        <item name="android:statusBarColor">@color/tb_canvas</item>
        <item name="android:navigationBarColor">@color/tb_canvas</item>
        <!-- Phase 8.18 — edge-to-edge keeps the canvas color visible
             behind transparent system bars until Compose draws the
             first frame, then `enableEdgeToEdge()` in MainActivity
             overlays the real theme. Consistent with Android 15+ -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
